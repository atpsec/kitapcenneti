# Google AdSense onayından sonra:
# VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx

# Membership / Stripe
# Browser: use either the membership API base or hosted Stripe Payment Links.
VITE_MEMBERSHIP_API_BASE=
VITE_STRIPE_PAYMENT_LINK_MONTHLY=
VITE_STRIPE_PAYMENT_LINK_ANNUAL=
VITE_SUPPORT_EMAIL=
VITE_LEGAL_COMPANY=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_REPRESENTATIVE=
VITE_LEGAL_REGISTER=
VITE_LEGAL_VAT_ID=
VITE_LEGAL_PHONE=
VITE_LEGAL_DPO_EMAIL=
VITE_LEGAL_SUPERVISORY_AUTHORITY=

# Cloudflare Pages Functions secrets (configure in the hosting dashboard)
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_LOCALE=de
# Set true only after a current Terms of Service URL is configured in Stripe Dashboard.
STRIPE_REQUIRE_TERMS=false
SITE_URL=https://atpsec.github.io/kitapcenneti

# Cloudflare Pages account/session API
AUTH_ALLOWED_ORIGIN=https://atpsec.github.io
AUTH_SESSION_TTL_DAYS=30
# Use None only when the frontend and API are on different sites. Lax is safer for same-site Cloudflare Pages.
AUTH_COOKIE_SAMESITE=Lax

# Optional account email delivery. Leave disabled until all values are configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_EMAIL_PROVIDER=resend
AUTH_EMAIL_API_KEY=
AUTH_EMAIL_FROM=
# Defaults to SITE_URL; set only when the app is served from another origin.
AUTH_EMAIL_APP_URL=
